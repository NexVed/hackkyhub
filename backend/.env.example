# Convex
CONVEX_URL=https://your-convex-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-convex-deployment

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Server-only administration credential. SCRAPER_SYNC_TOKEN is also supported
# as a fallback; direct legacy Convex writers require the matching value there.
SCRAPER_API_TOKEN=replace-with-a-long-random-token
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional comma-separated trusted custom scrape domains, without URL paths.
SCRAPER_ALLOWED_HOSTS=

# Current frontend-owned Convex ingestion (recommended over the legacy writer).
FRONTEND_SYNC_URL=https://your-project.convex.site/api/hackathons/sync
SCRAPER_SYNC_TOKEN=replace-with-the-matching-convex-token
APP_ENV=development
APP_RELEASE=
SENTRY_DSN=
# Optional Kafka mode; leave unused for the default HTTP CronJob.
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_API_KEY=
KAFKA_API_SECRET=
KAFKA_TOPIC=hackkyhub.hackathons.v1
KAFKA_DLQ_TOPIC=hackkyhub.hackathons.dlq.v1
KAFKA_GROUP_ID=hackkyhub-sync-v1
