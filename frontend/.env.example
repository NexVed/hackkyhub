# Convex
# Server-only URL of the FastAPI scraper service (without /api/v1).
SCRAPER_API_URL=http://localhost:8000

NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud
CONVEX_DEPLOYMENT=dev:your-project-name-123
# OAuth secrets, SITE_URL, JWKS and JWT_PRIVATE_KEY belong in the Convex
# deployment's environment, not this Next.js file. See docs/PRODUCTION_SETUP.md.

# Upstash Redis — server-only; do not use a NEXT_PUBLIC_ prefix.
# Optional: missing credentials bypass caching without blocking the dashboard.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
